{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@auxx/sdk/server": ["../../src/server/entities.ts"],
      "@auxx/sdk/fields": ["../../src/root/fields/index.ts"]
    }
  },
  "include": ["src", ".auxx/**/*"]
}
