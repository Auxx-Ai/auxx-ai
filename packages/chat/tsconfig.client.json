{
  "extends": "@auxx/typescript-config/base.json",
  "compilerOptions": {
    "outDir": "dist/client",
    "rootDir": "src",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "jsx": "preserve",
    "declaration": true,
    "declarationMap": true,
    "composite": false,
    "tsBuildInfoFile": "dist/.tsbuildinfo.client"
  },
  "include": ["src/client/**/*", "src/shared/env.ts", "src/globals.d.ts"]
}
