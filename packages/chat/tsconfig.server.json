{
  "extends": "@auxx/typescript-config/base.json",
  "compilerOptions": {
    "outDir": "dist/server",
    "rootDir": "src",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "declaration": true,
    "declarationMap": true,
    "composite": false,
    "tsBuildInfoFile": "dist/.tsbuildinfo.server"
  },
  "include": ["src/server/**/*"]
}
