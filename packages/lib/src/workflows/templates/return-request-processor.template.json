      {
        "id": "code_check_policy",
        "type": "standard",
        "position": {
          "x": 1500,
          "y": 200
        },
        "data": {
          "id": "code_check_policy",
          "type": "code",
          "title": "Check Return Policy",
          "desc": "Verify return eligibility: fulfillment status and 30-day window",
          "code_language": "javascript",
          "code": "const main = async (inputs) => {\n  const fulfillmentStatus = (inputs.fulfillmentStatus || '').toLowerCase()\n  const createdAt = inputs.createdAt || ''\n  const returnWindowDays = 30\n\n  const isDelivered = fulfillmentStatus === 'fulfilled'\n\n  let withinWindow = false\n  let daysSinceOrder = 0\n  if (createdAt) {\n    const orderDate = new Date(createdAt)\n    const now = new Date()\n    daysSinceOrder = Math.floor((now - orderDate) / (1000 * 60 * 60 * 24))\n    withinWindow = daysSinceOrder <= returnWindowDays\n  }\n\n  const eligible = isDelivered && withinWindow\n  let reason = ''\n  if (!isDelivered) {\n    reason = 'Order has not been fulfilled or delivered yet'\n  } else if (!withinWindow) {\n    reason = `Order is outside the ${returnWindowDays}-day return window (${daysSinceOrder} days ago)`\n  } else {\n    reason = 'Order is eligible for return'\n  }\n\n  return {\n    eligible: eligible ? 'yes' : 'no',\n    reason: reason,\n    daysSinceOrder: String(daysSinceOrder)\n  }\n}",
          "inputs": [
            {
              "name": "fulfillmentStatus",
              "variableId": "shopify_get_order.order.fulfillmentStatus"
            },
            {
              "name": "createdAt",
              "variableId": "shopify_get_order.order.createdAt"
            }
          ],
          "outputs": [
            {
              "name": "eligible",
              "type": "string",
              "description": "Whether the return is eligible: 'yes' or 'no'"
            },
            {
              "name": "reason",
              "type": "string",
              "description": "Human-readable explanation of eligibility"
            },
            {
              "name": "daysSinceOrder",
              "type": "string",
              "description": "Number of days since the order was placed"
            }
          ]
        },
        "width": 244,
        "height": 100
      },
