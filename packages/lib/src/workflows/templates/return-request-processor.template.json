{
  "slug": "return-request-processor",
  "name": "Return Request Processor",
  "description": "When a customer emails about a return, this workflow extracts the order number, looks up the order in Shopify, runs a return policy check (30-day window, fulfillment status), and routes to the appropriate path. Eligible returns go to human approval before confirming. Ineligible returns get a polite explanation. If no order number is found, the customer is asked to provide one.",
  "categories": ["customer-service", "shopify", "e-commerce", "ai"],
