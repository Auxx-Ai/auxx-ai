                }
              },
              "required": ["order_number", "return_reason"]
            }
          },
          "vision": {
            "enabled": false
          },
          "instruction": {
            "enabled": true,
            "text": "Extract return request details from the customer email. Look for the order number (patterns like #1042, order 1042, order number 1042) and return only the numeric part. Identify which item they want to return and why. Categorize the reason as: defective, wrong-item, not-as-described, changed-mind, sizing-issue, or other."
          }
