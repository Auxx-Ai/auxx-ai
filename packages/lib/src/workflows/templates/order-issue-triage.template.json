{
  "slug": "order-issue-triage",
  "name": "Order Issue Triage & Resolution",
  "description": "When a customer message arrives, extract order details, look up or create the contact and order records, classify the issue type, and route to the appropriate resolution path. Demonstrates system entity refs, custom entity refs, CRUD create/update/find modes, optional entities, companion templates, app nodes, and variable references.",
  "categories": ["customer-service", "e-commerce", "shopify"],
  "status": "public",
  "version": 1,
  "popularity": 50,
  "imgUrl": null,
  "icon": {
    "iconId": "shopping-cart",
    "color": "green"
  },
  "triggerType": "message-received",
  "triggerConfig": {
    "channel": "email"
  },
  "requiredApps": [
    {
      "appSlug": "shopify",
      "appTitle": "Shopify",
      "blockIds": ["shopify"],
      "triggerIds": [],
      "required": true
    },
    {
      "appSlug": "slack",
      "appTitle": "Slack",
      "blockIds": ["send-message"],
      "triggerIds": [],
      "required": false
    }
  ],
  "requiredEntities": [
    {
      "$comment": "TECHNIQUE 1: System entity — always exists, fields resolved via systemAttribute matching. No installation needed. Keys are the systemAttribute names used both as @field: refs in CRUD nodes and as the lookup value.",
      "entityTemplateId": "__system:contact",
      "name": "Contact",
      "apiSlug": "contact",
      "fieldMapping": {
        "primary_email": "primary_email",
        "first_name": "first_name",
        "last_name": "last_name",
        "phone": "phone"
      },
      "requiredFields": ["primary_email"],
      "required": true
    },
    {
      "$comment": "TECHNIQUE 2: System entity (ticket) — systemAttribute values from TICKET_FIELDS: ticket_status, ticket_priority, ticket_title.",
      "entityTemplateId": "__system:ticket",
      "name": "Ticket",
      "apiSlug": "ticket",
      "fieldMapping": {
        "ticket_status": "ticket_status",
        "ticket_priority": "ticket_priority"
      },
      "requiredFields": ["ticket_status"],
      "required": true
    },
    {
      "$comment": "TECHNIQUE 3: Custom entity from built-in template — requires installation if not present. All fields mapped 1:1 to templateFieldIds from order.json.",
      "entityTemplateId": "order",
      "name": "Order",
      "apiSlug": "orders",
      "icon": "shopping-cart",
      "color": "green",
      "fieldMapping": {
        "orderNumber": "orderNumber",
        "orderTotal": "orderTotal",
        "status": "status",
        "priority": "priority",
        "orderDate": "orderDate",
        "shippingAddress": "shippingAddress",
        "trackingUrl": "trackingUrl",
        "itemsOrdered": "itemsOrdered",
        "requiresFollowUp": "requiresFollowUp",
        "internalNotes": "internalNotes",
        "assignedTo": "assignedTo"
      },
      "requiredFields": ["orderNumber", "status"],
      "companionTemplateIds": ["return-request", "shipment"],
      "required": true
    },
    {
      "$comment": "TECHNIQUE 4: System entity with a subset of fields — like contact and ticket above, company is a system entity definition, so it always exists and needs no installation. Field keys are systemAttribute values from COMPANY_FIELDS. Only the fields referenced by CRUD/Find nodes need to be in fieldMapping.",
      "entityTemplateId": "__system:company",
      "name": "Company",
      "apiSlug": "company",
      "fieldMapping": {
        "company_name": "company_name",
        "company_website": "company_website",
        "company_industry": "company_industry"
      },
      "requiredFields": ["company_name"],
      "companionTemplateIds": ["deal"],
      "required": true
    },
    {
      "$comment": "TECHNIQUE 5: Optional custom entity — workflow degrades gracefully if not installed. The CRUD node referencing this will be left unresolved (user can configure manually).",
      "entityTemplateId": "deal",
      "name": "Deal",
      "apiSlug": "deals",
      "icon": "handshake",
      "color": "green",
      "fieldMapping": {
        "dealName": "dealName",
        "value": "value",
        "stage": "stage",
        "probability": "probability",
        "expectedCloseDate": "expectedCloseDate"
      },
      "requiredFields": ["dealName", "stage"],
      "required": false
    }
  ],
