      {
        "$comment": "── INFORMATION EXTRACTOR ── Extract structured data from the incoming message",
        "id": "extractor-002",
        "type": "standard",
        "position": {
          "x": 350,
          "y": 300
        },
        "data": {
          "id": "extractor-002",
          "type": "information-extractor",
          "title": "Extract Order & Customer Info",
          "desc": "Extract order number, customer details, and urgency from the email",
          "model": {
            "useDefault": true,
            "provider": "",
            "name": "",
            "mode": "chat",
            "completion_params": {
              "temperature": 0.2
            }
          },
          "text": "Subject: {{trigger-001.message.subject}}\n\nBody: {{trigger-001.message.body}}",
          "structured_output": {
            "enabled": true,
            "schema": {
              "type": "object",
              "properties": {
                "orderNumber": {
                  "type": "string",
                  "description": "The Shopify order number. Extract digits only. Empty string if not found."
                },
                "firstName": {
                  "type": "string",
                  "description": "Customer's first name"
                },
                "lastName": {
                  "type": "string",
                  "description": "Customer's last name"
                },
                "email": {
                  "type": "string",
                  "description": "Customer's email address"
                },
                "issueDescription": {
                  "type": "string",
                  "description": "Brief description of the customer's issue"
                },
                "urgency": {
                  "type": "string",
                  "enum": ["low", "normal", "high", "urgent"],
                  "description": "Urgency level of the issue"
                },
                "companyName": {
                  "type": "string",
                  "description": "The customer's company or organisation name, from the email signature, the sender's domain, or the message body. Empty string if this is clearly a private individual."
                }
              },
              "required": ["orderNumber", "email", "issueDescription"]
            }
          },
          "vision": {
            "enabled": false
          },
          "instruction": {
            "enabled": true,
            "text": "Extract the following from the customer message:\n- Order number\n- Customer name (first and last)\n- Customer email\n- Issue description\n- Urgency level (low, normal, high, urgent)\n- Company name, if the customer is writing on behalf of a business"
          }
        },
        "width": 244,
        "height": 100
      },
