# Auxx.ai Environment Template
#
# Usage:
# - Local/cloud dev: ./setup.sh
# - Self-hosted:     ./setup.sh --self-hosted
#
# Default local ports:
# web=3000, homepage=3001, kb=3002, docs=3004, worker=3005, build=3006, api=3007, lambda=3008

# ------------------------------------
# Deployment
# ------------------------------------
# cloud (SaaS/local) or self-hosted
DEPLOYMENT_MODE=cloud

# Demo system (anonymous demo sessions). Set to true to enable.
DEMO_ENABLED=false

# Root domain used to derive app URLs in deployed environments.
# Leave empty for local development.
DOMAIN=

# Self-hosted only: email used by Traefik Let's Encrypt certificate resolver
ACME_EMAIL=

# Self-hosted image tag (docker-compose.self-hosted.yml)
VERSION=latest

# Suppress browserslist staleness warnings during builds
BROWSERSLIST_IGNORE_OLD_DATA=1

# SST / infra
AWS_REGION=us-west-1
HOSTED_ZONE=

# ------------------------------------
# Runtime URL Overrides (optional)
# ------------------------------------
# If unset, URLs derive from DOMAIN (or localhost fallbacks).
APP_URL=
HOMEPAGE_URL=
API_URL=
DOCS_URL=
DEV_PORTAL_URL=
KB_URL=
LAMBDA_URL=

# Public KB cache invalidation (admin → apps/kb webhook).
# KB_PUBLIC_URL is the apps/kb origin (e.g. https://kb.auxx.ai).
# KB_REVALIDATE_SECRET is a shared secret used as a Bearer token.
# KB_ROOT_HOST is the canonical KB host (apps/kb proxy uses it to detect custom domains).
KB_PUBLIC_URL=
KB_REVALIDATE_SECRET=
KB_ROOT_HOST=
KB_MARKETING_URL=

# ------------------------------------
# Auto-Generated Secrets (filled by setup.sh)
# ------------------------------------
DATABASE_PASSWORD=
REDIS_PASSWORD=
BETTER_AUTH_SECRET=
API_KEY_SALT=
LAMBDA_INVOKE_SECRET=
# Credential secret encryption (AES-256-GCM). Generate: openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY=
PUBLIC_WORKFLOW_JWT_SECRET=
SDK_CLIENT_SECRET=
LOGIN_TOKEN_PRIVATE_KEY=
LOGIN_TOKEN_PUBLIC_KEY=
BUILD_SESSION_SECRET=
KB_SESSION_SECRET=

# ------------------------------------
# Core App Settings
# ------------------------------------
IS_CONFIG_VARIABLES_IN_DB_ENABLED=true
WORKER_PORT=3005
SKIP_CHAT_SESSION_VERIFICATION=true

# Port overrides (used by docker/docker-compose.yml, set by install.sh if conflict)
# APP_PORT=3000
# API_PORT=3007
# LAMBDA_PORT=3008

# Optional: bootstrap super admin email
SUPER_ADMIN_EMAIL=

# ------------------------------------
# Database & Redis
# ------------------------------------
# setup.sh fills DATABASE_URL from DATABASE_PASSWORD and deployment mode.
DATABASE_URL=
REDIS_HOST=localhost
REDIS_PORT=6379

# Pool tuning (optional — sensible defaults apply)
# DB_POOL_MAX=10
# DB_POOL_IDLE_TIMEOUT=30000
# DB_QUERY_LOGGING=true
# APP_NAME=auxx-ai

# ------------------------------------
# Log history (OpenObserve) — dev only
# ------------------------------------
# `pnpm dev` starts the openobserve container and apps ship logs to it
# automatically in dev. UI: http://localhost:5080 (stream `auxx`).
# Credentials below must match the docker-compose `openobserve` service.
OPENOBSERVE_EMAIL=root@auxx.dev
# Quoted because Node's --env-file (used by the worker) treats an unquoted # as a comment.
OPENOBSERVE_PASSWORD="Complexpass#123"
# Turn log shipping off entirely:
# OPENOBSERVE_DISABLE=true
# Override the target (e.g. a remote collector):
# OPENOBSERVE_URL=http://localhost:5080
# OPENOBSERVE_ORG=default
# OPENOBSERVE_STREAM=auxx
# OPENOBSERVE_PORT=5080

# ------------------------------------
# Storage (S3 / S3-compatible)
# ------------------------------------
FILE_STORAGE_TYPE=s3

# For AWS S3: leave S3_ENDPOINT empty
# For S3-compatible providers: set endpoint URL
S3_ENDPOINT=

S3_REGION=us-west-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Public bucket (avatars, logos, thumbnails)
S3_PUBLIC_BUCKET=auxx-dev-public
# Private bucket (attachments, temp files)
S3_PRIVATE_BUCKET=auxx-dev-private

# Public CDN/base URL for asset delivery
CDN_URL=https://auxx-dev-public.s3.us-west-1.amazonaws.com

# ------------------------------------
# AI Providers
# ------------------------------------
USE_BACKUP_MODEL=false

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GOOGLE_API_KEY=
GROQ_API_KEY=
BEDROCK_ACCESS_KEY=
BEDROCK_SECRET_KEY=

# ------------------------------------
# Auth Login Providers
# ------------------------------------
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ------------------------------------
# Google Workspace / Gmail
# ------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PROJECT_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_PUBSUB_TOPIC=email-notifications
GOOGLE_PUBSUB_SUBSCRIPTION=email-notifications-sub
GOOGLE_PUBSUB_VERIFICATION_TOKEN=

# ------------------------------------
# Integrations
# ------------------------------------
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Shopify App Pricing (billing v2). See plans/billing/v2/04-partner-api-client.md §1.
# Hot path — Admin API subscription read:
SHOPIFY_APP_ID=             # internal App.id row (our catalog), used by getAppConnection
SHOPIFY_APP_HANDLE=         # URL-safe app slug (name in shopify.app.toml); builds the pricing-page URL
# Optional — Partner API events/transactions backstop only (not used on the hot path):
SHOPIFY_APP_GID=            # gid://partners/App/1234 — PARTNERS namespace, not shopify
SHOPIFY_PARTNER_ORG_ID=     # numeric segment of partners.shopify.com/{org_id}/...
SHOPIFY_PARTNER_API_VERSION=2026-04

OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_WEBHOOK_SECRET=

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_API_VERSION=v26.0
FACEBOOK_WEBHOOK_VERIFY_TOKEN=

# ------------------------------------
# Email
# ------------------------------------
# mailgun | ses | smtp | sendmail
EMAIL_PROVIDER=mailgun

MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_REGION=us

SYSTEM_FROM_EMAIL=noreply@m.auxx.ai
SYSTEM_FROM_NAME=System
SUPPORT_EMAIL=support@m.auxx.ai
SUPPORT_NAME=Support Team
EMAIL_REPLY_TO=

# SMTP (EMAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ------------------------------------
# Billing
# ------------------------------------
ENABLE_AUTO_TRIAL=true
TRIAL_PLAN_NAME=Growth
TRIAL_DAYS=14

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Money MP1 — Stripe Connect payment collection (separate webhook/secret from billing above;
# reuses STRIPE_SECRET_KEY as the platform key). No STRIPE_CONNECT_CLIENT_ID — MP1 uses
# Account Links, not OAuth, so there's no `ca_…` client id to configure.
STRIPE_CONNECT_WEBHOOK_SECRET=
PAYMENTS_APPLICATION_FEE_PERCENT=2

# ------------------------------------
# Realtime & Analytics
# ------------------------------------
# Realtime runs on self-hosted Sockudo (Pusher-protocol compatible) — see
# apps/echtzeit. Locally it's the `echtzeit` docker-compose service on
# ws://127.0.0.1:6001. The PUSHER_* names are kept (drop-in); the compose
# service maps them onto SOCKUDO_DEFAULT_APP_*, so these creds MUST match.
#
# PUSHER_HOST routes the SDKs at Sockudo. Leave it EMPTY to fall back to the
# hosted Pusher cloud (the kept seam) — then set PUSHER_CLUSTER + real creds.
PUSHER_HOST=127.0.0.1
PUSHER_PORT=6001
PUSHER_USE_TLS=false       # prod = true (Railway wss edge); localhost = false
PUSHER_APP_ID=auxx
PUSHER_KEY=auxx-key
PUSHER_SECRET=auxx-secret
PUSHER_CLUSTER=us3         # only used when PUSHER_HOST is empty (Pusher cloud)

POSTHOG_KEY=
POSTHOG_HOST=

# ------------------------------------
# Website crawler (Knowledge Sources)
# ------------------------------------
# CRAWL_PROVIDER selects the crawl backend (default: firecrawl).
# FIRECRAWL_API_KEY is required to crawl websites into a knowledge base.
CRAWL_PROVIDER=firecrawl
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev

# ------------------------------------
# Cloudflare Turnstile (Captcha)
# ------------------------------------
# Use testing keys for local dev: https://developers.cloudflare.com/turnstile/troubleshooting/testing/
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=1x00000000000000000000AA

# ------------------------------------
# Recall.ai — Meeting Recording Bot Service
# ------------------------------------
RECALL_AI_API_KEY=
RECALL_AI_WEBHOOK_SECRET=
RECALL_AI_REGION=us-west-2

# ------------------------------------
# Geolocation (optional) — used to surface visitor city in the chat widget
# ------------------------------------
# Provider: "maxmind" (default), "ipapi" (no signup, rate-limited free tier),
# or "none" (disable geolocation entirely).
AUXX_GEO_PROVIDER=maxmind
# Required when AUXX_GEO_PROVIDER=maxmind. Sign up free at https://www.maxmind.com,
# generate a GeoLite2 license key. The API container downloads GeoLite2-City
# automatically on first boot. License terms forbid us from redistributing the db.
MAXMIND_LICENSE_KEY=
# Override default mmdb location. Default is ./geo/GeoLite2-City.mmdb,
# resolved relative to the API process cwd. Works in both Docker (cwd=/app
# → /app/geo/...) and local dev (cwd=apps/api → apps/api/geo/...) without
# needing an override.
# MAXMIND_DB_PATH=./geo/GeoLite2-City.mmdb
# Dev-only: nothing sets x-forwarded-for locally, so the chat widget's IP and
# geo-derived visit fields (visit_ip/city/region/country/timezone) are always
# empty. Set a real public IP to exercise the full IP → geo → visit-field path
# with the real widget. Ignored when NODE_ENV=production. Clear the widget's
# stored passport after changing this — geo is resolved once at mint (~1h TTL).
# CHAT_DEV_FAKE_IP=8.8.8.8

# ------------------------------------
# Maps (optional) — dispatch route planner (plans/dispatch/09-route-planner.md)
# ------------------------------------
# Geocoding: MapTiler (https://cloud.maptiler.com, free tier available). Absent →
# geocode() resolves null; visits/the org depot stay unpinned, never a hard error.
MAPTILER_API_KEY=
# Directions: Mapbox (https://account.mapbox.com, free tier available). Absent →
# route legs fall back to straight-line geometry + haversine ETA @ 40km/h.
MAPBOX_ACCESS_TOKEN=
